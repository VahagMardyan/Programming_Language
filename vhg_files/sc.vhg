print("=== Switch Test ===\n");
x = 2;

switch(x) {
    case 1:
        print("One\n");
        break;
    case 2, 3, 4:
        print("Two, Three or Four\n");
        break;
    case 5:
        print("Five\n");
        break;
    default:
        print("Other\n");
}

print("\n=== Fallthrough test ===\n");
y = 10;
switch(y) {
    case 10:
        print("Ten, then fallthrough\n");
    case 20:
        print("Twenty\n");
        break;
    default:
        print("Not 10 nor 20\n");
}

print("\n=== Switch with no match ===\n");
z = 100;
switch(z) {
    case 1: print("1\n"); break;
    case 2: print("2\n"); break;
    default: print("Default\n");
}

print("\n=== Should print only this ===\n");
q = 1000;
switch(q) {
    case 1, 3, 55: {
        print("1, 3 or 55");
    }
    break;
    case 1001, 1004:
        print("1001 or 1004");
    break;
}