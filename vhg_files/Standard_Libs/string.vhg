function is_palindrome(s) {
    variable l, r = 0, length(s) - 1;
    while (l < r) {
        if(s[l] != s[r]) {
            return false;
        }
        l += 1;
        r -= 1;
    }
    return true;
}

function reverse_string(s) {
    variable result = "";
    variable n = length(s);
    for(variable i = n - 1; i >= 0; i -= 1) {
        result += s[i];
    }
    return result;
}

function to_upper(s) {
    variable result = "";
    for (variable i = 0; i < length(s); i += 1) {
        variable c = s[i];
        variable code = ord(c);
        if (code >= ord('a') and code <= ord('z')) {
            c = chr(ord(c) - 32);
        }
        result += c;
    }
    return result;
}

function to_lower(s) {
    variable result = "";
    for(variable i = 0; i < length(s); i += 1) {
        variable c = s[i];
        variable code = ord(c);
        if(code >= ord("A") and code <= ord("Z")) {
            c = chr(ord(c) + 32);
        }
        result += c;
    }
    return result;
}

function substring(s, start, end) {
    variable result = "";
    for(variable i = start; i < end and i < length(s); i+=1) {
        result += s[i];
    }
    return result;
}

function index_of(s, char) {
    for(variable i = 0; i < length(s); i += 1) {
        if(s[i] == char) {
            return i;
        }
    }
    return -1;
}

function count_char(s, char) {
    variable count = 0;
    for(variable i = 0; i < length(s); i+=1) {
        if(s[i] == char) count += 1;
    }
    return count;
}

function replace_char(s, old, new) {
    variable result = "";
    for(variable i = 0; i < length(s); i += 1) {
        if(s[i] == old) {
            result += new;
        } else {
            result += s[i];
        }
    }
    return result;
}

function starts_with(s, prefix) {
    variable prefix_len = length(prefix);
    if(prefix_len > length(s)) return false;

    for(variable i = 0; i < prefix_len; i += 1) {
        if(s[i] != prefix[i]) return false;
    }
    return true;
}

function ends_with(s, suffix) {
    variable suffix_len = length(suffix);
    variable s_len = length(s);
    if (suffix_len > s_len) return false;
    for (variable i = 0; i < suffix_len; i += 1) {
        if (s[s_len - suffix_len + i] != suffix[i]) return false;
    }
    return true;
}

function trim(s) {
    variable left = 0;
    variable right = length(s) - 1;
    
    while (left <= right and s[left] == ' ') {
        left += 1;
    }
    while (right >= left and s[right] == ' ') {
        right -= 1;
    }
    
    variable result = "";
    for (variable i = left; i <= right; i += 1) {
        result += s[i];
    }
    return result;
}

function split_first(s, delimiter) {
    variable result = "";
    for(variable i = 0; i < length(s); i += 1) {
        if(s[i] == delimiter) {
            return result;
        }
        result += s[i];
    }
    return result;
}

function split_last(s, delimiter) {
    variable n = length(s);
    for(variable i = n - 1; i >= 0; i -= 1) {
        if(s[i] == delimiter) {
            variable result = "";
            for(variable j = i + 1; j < n; j += 1) {
                result += s[j];
            }
            return result;
        }
    }
    return "";
}

function repeat(s, n) {
    variable result = "";
    for(variable i = 0; i < n; i += 1) {
        result += s;
    }
    return result;
}