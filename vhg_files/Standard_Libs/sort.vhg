#*
    Array sorting algorithms implementation with VHG.
    When reverse = true then each algorithm will sort by descending order.
    Otherwise, in ascending order.
    By default: reverse = false
*#

# Bubble sort
void function bubble_sort(arr, reverse = false) {
    variable n = length(arr);
    for (variable i = 0; i < n; i += 1) {
        variable swapped = false;
        for(variable j = 0; j < n - i - 1; j += 1) {
            if (not reverse) {
                if (arr[j] > arr[j + 1]) {
                    var tmp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = tmp;
                    swapped = true;
                }
            } else {
                if (arr[j] < arr[j + 1]) {
                    var tmp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = tmp;
                    swapped = true;
                }
            }
        }
        if (not swapped) break;
    }
}

# Merge sort
void function merge(arr, left, mid, right, reverse) {
    var n1 = mid - left + 1;
    var n2 = right - mid;
    var L = [0] * n1;
    var R = [0] * n2;

    for(var i = 0; i < n1; i += 1) {
        L[i] = arr[left + i];
    }
    for(var j = 0; j < n2; j += 1) {
        R[j] = arr[mid + 1 + j];
    }

    var i = 0;
    var j = 0;
    var k = left;

    while(i < n1 and j < n2) {
        variable cond;
        if (not reverse) {
            cond = L[i] <= R[j];
        } else {
            cond = L[i] >= R[j];
        }
        if(cond) {
            arr[k] = L[i];
            i += 1;
        } else {
            arr[k] = R[j];
            j += 1;
        }
        k += 1;
    }

    while(i < n1) {
        arr[k] = L[i];
        i += 1;
        k += 1;
    }
    while(j < n2) {
        arr[k] = R[j];
        j += 1;
        k += 1;
    }
}

void function merge_sort(arr, left, right, reverse = false) {
    if(left < right) {
        var mid = (left + right) // 2;
        merge_sort(arr, left, mid, reverse);
        merge_sort(arr, mid + 1, right, reverse);
        merge(arr, left, mid, right, reverse);
    }
}

# Quick sort
function partition(arr, low, high, reverse) {
    var pivot = arr[high];
    var i = low - 1;
    var j = low;

    while(j < high) {
        variable cond;
        if (not reverse) {
            cond = arr[j] <= pivot;
        } else {
            cond = arr[j] >= pivot;
        }
        if(cond) {
            i += 1;
            var temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
        j += 1;
    }
    var temp = arr[i + 1];
    arr[i + 1] = arr[high];
    arr[high] = temp;
    return i + 1;
}

void function quick_sort(arr, low, high, reverse = false) {
    if(low < high) {
        var pi = partition(arr, low, high, reverse);
        quick_sort(arr, low, pi - 1, reverse);
        quick_sort(arr, pi + 1, high, reverse);  
    }
}

# Selection sort
void function selection_sort(arr, reverse = false) {
    variable n = length(arr);
    var i = 0;
    while(i < n - 1) {
        var target_idx = i;
        var j = i + 1;
        while (j < n) {
            if (not reverse) {
                if (arr[j] < arr[target_idx]) {
                    target_idx = j;
                }
            } else {
                if (arr[j] > arr[target_idx]) {
                    target_idx = j;
                }
            }
            j += 1;
        }
        if(target_idx != i) {
            var temp = arr[i];
            arr[i] = arr[target_idx];
            arr[target_idx] = temp;
        }
        i += 1;
    }
}

# Insertion sort
void function insertion_sort(arr, reverse = false) {
    var n = length(arr);
    var i = 1;
    while (i < n) {
        var key = arr[i];
        var j = i - 1;
        while (j >= 0 and ((not reverse and arr[j] > key) or (reverse and arr[j] < key))) {
            arr[j + 1] = arr[j];
            j -= 1;
        }
        arr[j + 1] = key;
        i += 1;
    }
}

# Heap sort
void function heapify(arr, index, heap_size, reverse) {
    var l = 2 * index + 1;
    var r = 2 * index + 2;
    var extreme = index;   # "extreme" = largest for ascending, smallest for descending

    if (not reverse) {
        if (l < heap_size and arr[l] > arr[extreme]) extreme = l;
        if (r < heap_size and arr[r] > arr[extreme]) extreme = r;
    } else {
        if (l < heap_size and arr[l] < arr[extreme]) extreme = l;
        if (r < heap_size and arr[r] < arr[extreme]) extreme = r;
    }

    if (extreme != index) {
        var temp = arr[extreme];
        arr[extreme] = arr[index];
        arr[index] = temp;
        heapify(arr, extreme, heap_size, reverse);
    }
}

void function build_heap(arr, reverse) {
    var heap_size = length(arr);
    for(var i = heap_size // 2 - 1; i > -1; i -= 1) {
        heapify(arr, i, heap_size, reverse);
    }
}

void function heap_sort(arr, reverse = false) {
    var heap_size = length(arr);
    build_heap(arr, reverse);
    for(var i = heap_size - 1; i > 0; i -= 1) {
        var temp = arr[i];
        arr[i] = arr[0];
        arr[0] = temp;
        heapify(arr, 0, i, reverse);
    }
}

# Counting sort

function min(nums) {
    var min_value = nums[0];
    var n = length(nums);
    for(variable i = 0; i < n; i += 1) {
        if(nums[i] < min_value) {
            min_value = nums[i];
        }
    }
    return min_value;
}

function max(nums) {
    var max_value = nums[0];
    var n = length(nums);
    for(variable i = 0; i < n; i += 1) {
        if(nums[i] > max_value) {
            max_value = nums[i];
        }
    }
    return max_value;
}

function count_sort(arr, reverse = false) {
    if (not arr) {
        return [];
    }
    var n = length(arr);
    var min_val = min(arr);   # assume min/max functions exist
    var max_val = max(arr);
    var range = max_val - min_val + 1;
    var cnt = [0] * range;

    for(var i = 0; i < n; i += 1) {
        cnt[arr[i] - min_val] += 1;
    }

    # Build cumulative counts
    for(var i = 1; i < range; i += 1) {
        cnt[i] += cnt[i - 1];
    }

    var ans = [0] * n;

    # Stable placement
    for(var i = n - 1; i > -1; i -= 1) {
        var val = arr[i];
        var idx = val - min_val;
        ans[cnt[idx] - 1] = val;
        cnt[idx] -= 1;
    }

    if (reverse) {
        # Reverse the result
        var rev = [0] * n;
        for(var i = 0; i < n; i += 1) {
            rev[i] = ans[n - 1 - i];
        }
        return rev;
    }
    return ans;
}

# Radix sort
void function count_sort_for_radix(arr, e, reverse) {
    var n = length(arr);
    var output = [0] * n;
    var count = [0] * 10;
    for(var i = 0; i < n; i += 1) {
        var index = (arr[i] // e) % 10;
        count[index] += 1;
    }
    for(var i = 1; i < 10; i += 1) {
        count[i] += count[i - 1];
    }
    for(var i = n - 1; i > -1; i -= 1) {
        var index = (arr[i] // e) % 10;
        output[count[index] - 1] = arr[i];
        count[index] -= 1;
    }
    for(var i = 0; i < n; i += 1) {
        arr[i] = output[i];
    }
}

function radix_sort(arr, reverse = false) {
    if (not arr) {
        return arr;
    }
    var max_val = max(arr);
    var e = 1;
    while(max_val // e > 0) {
        count_sort_for_radix(arr, e, reverse);   # reverse parameter unused inside counting (could ignore)
        e *= 10;
    }
    if (reverse) {
        # Reverse the result
        var n = length(arr);
        var rev = [0] * n;
        for(var i = 0; i < n; i += 1) {
            rev[i] = arr[n - 1 - i];
        }
        # Copy back (or return rev, but we're sorting in-place? We'll modify arr)
        for(var i = 0; i < n; i += 1) {
            arr[i] = rev[i];
        }
    }
    return arr;
}

