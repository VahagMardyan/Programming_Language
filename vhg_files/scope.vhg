void function main() {
print("=== Variable Scope Test ===\n");

# ----------------------------------
# 1. Top-level (should be GLOBAL)
# ----------------------------------
print("--- 1. Top-level ---\n");
a = 10;
print("a = ", a, "\n");          # 10

# ----------------------------------
# 2. Block scope (should be LOCAL)
# ----------------------------------
print("--- 2. Block scope ---\n");
{
    b = 20;
    print("Inside block, b = ", b, "\n");  # 20
}
# b should be undefined here
# print("Outside block, b = ", b, "\n");  # Should be ERROR

# ----------------------------------
# 3. Explicit local
# ----------------------------------
print("--- 3. Explicit local ---\n");
{
    local c = 30;
    print("Inside block, c = ", c, "\n");  # 30
}
# c should be undefined here

# ----------------------------------
# 4. Explicit global
# ----------------------------------
print("--- 4. Explicit global ---\n");
{
    global d = 40;
    print("Inside block, d = ", d, "\n");  # 40
}
print("Outside block, d = ", d, "\n");     # 40 (global)

# ----------------------------------
# 5. Function accessing global
# ----------------------------------
print("--- 5. Function with global ---\n");
global e = 50;

void function testGlobal() {
    print("Inside function, e = ", e, "\n");  # 50
    e += 10;
    print("After +=, e = ", e, "\n");         # 60
}

testGlobal();
print("Outside function, e = ", e, "\n");     # 60

# ----------------------------------
# 6. Function with local (default)
# ----------------------------------
print("--- 6. Function with local ---\n");

void function testLocal() {
    f = 70;  # Should be LOCAL to function
    print("Inside function, f = ", f, "\n");  # 70
}
testLocal();
# print("Outside function, f = ", f, "\n");  # Should be ERROR

# ----------------------------------
# 7. For loop variable
# ----------------------------------
print("--- 7. For loop variable ---\n");

for (g = 0; g < 3; g = g + 1) {
    print("g = ", g, " ");  # 0 1 2
}
print("\n");
# g should be undefined here (local to for scope)

# ----------------------------------
# 8. Nested blocks
# ----------------------------------
print("--- 8. Nested blocks ---\n");

{
    local h = 80;
    {
        local i = 90;
        print("Inner: h=", h, " i=", i, "\n");  # h=80 i=90
    }
    print("Outer: h=", h, "\n");  # h=80
    # print("i=", i);  # Should be ERROR
}

# ----------------------------------
# 9. If/else scope
# ----------------------------------
print("--- 9. If/else scope ---\n");

if (1) {
    local j = 100;
    print("Inside if, j = ", j, "\n");  # 100
}
# print("Outside if, j = ", j, "\n");  # Should be ERROR

# ----------------------------------
# 10. While loop variable
# ----------------------------------
print("--- 10. While loop ---\n");

k = 0;
while (k < 3) {
    local m = k * 10;
    print("m = ", m, " ");  # 0 10 20
    k = k + 1;
}
print("\n");
# print("Outside while, m = ", m);  # Should be ERROR

# ----------------------------------
# 11. Global x before and after function
# ----------------------------------
print("--- 11. Global x ---\n");

global x = 10;

void function foo() {
    x += 55;
    print("Inside foo, x = ", x, "\n");  # 65
}

foo();
print("Outside foo, x = ", x, "\n");     # 65

print("\n=== All tests completed ===\n");
}