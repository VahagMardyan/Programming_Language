function min(a, b, c, d) {
    min_val = a < b ? a : b;
    min_out = c < min_val ? c : min_val;
    return d < min_out ? d : min_out;
}

void function printSpiralPattern(n) {

    if(n <= 0) {
        print("n must be a positive integer");
        return;
    }

    if(fmod(n,1) != 0) {
        print("n must be an integer");
        return;
    }

    for (i = 0; i < n; i+=1) {
        for (j = 0; j < n; j+=1) {
            # Find the distance to the nearest edge (the "layer")
            x = i;
            y = j;
            ring = min(x, y, n - 1 - x, n - 1 - y);

            # Logic for a square spiral pattern
            if (ring % 2 == 0) {
                # Determine which symbol to use (alternating for contrast)
                if (i <= n / 2) {
                   if (i == ring + 1 and j == ring)  print("  ",""); # The "break"
                   else print("* ","");
                } else {
                    print("# ","");
                }
            } else {
                print("  ","");
            }
        }
        print("\n","");
    }
}

n = input("n=");
printSpiralPattern(n);
