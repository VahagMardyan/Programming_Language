function fib(n) {
   if (n <= 1) {
      return n;
   }
   
   local a = 0;
   local b = 1;
   local result = 0;
   
   for (i = 2; i <= n; i = i + 1) {
      result = a + b;
      a = b;
      b = result;
   }
   return result;
}

