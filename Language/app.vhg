function factorial(n) {
    local r = 1;
    local i = 1;
    while(i <= n) {
        r = r * i;
        i = i + 1;
    }
    return r;
}

function factorial(n) {
    result = 1;
    for(i=2;i<=n;i+=1) {
        result *= i;
    }
    return result;
}
q = factorial(5);
print(q);
