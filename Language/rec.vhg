# # Factorial
function factorial(n) {
    if(n == 0 or n == 1) {
        return 1;
    }
    return n * factorial(n-1);
}

# # Fibonacci
function fib(n) {
    if(n <= 1) {
        return n;
    }
    return fib(n-1) + fib(n-2);
}

function isFib(n) {
    n1 = sqrt(5*n**2 + 4);
    n2 = sqrt(5*n**2 - 4);
    return (fmod(n1, 1) == 0 or fmod(n2,1) == 0);
}

# # Greatest Common Divisor
function gcd(a, b) {
    if(b == 0) {
        return a;
    }
    return gcd(b, a % b);
}

# # Least Common Multiple
function lcm(a, b) {
    return (a * b) / gcd(a,b);
}

# # x^n
function x_n(x,n) {
    if(n == 0) {
        return 1;
    }
    return x * x**(n-1);
}

function add(a) {
    return a + 4;
}
 
void function foo() {
    x = add(3);
    print(x*5);
}

void function even_odd() {
    for(i=0;i<5;i+=1) {
        print(i, " ",i % 2 == 0 ? "Even" : "Odd","\n"); # # Ternary operator
    }
}

x = 5 > 0 ? 6 : 7;
print(x); # 6
print(factorial(6)); # 720
print(fib(6)); # 8
print(isFib(6) ? "true" : "false"); # false
print(gcd(4,18)); # 2
print(lcm(4,18)); # 36
print(x_n(3,4)); # 81
foo(); # 35
even_odd();
